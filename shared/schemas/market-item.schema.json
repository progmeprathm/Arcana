{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "MarketItem",
  "type": "object",
  "required": ["id", "name", "category", "unit_price", "unit", "in_stock", "provenance"],
  "properties": {
    "id": { "type": "string" },
    "name": { "type": "string" },
    "botanical_name": { "type": ["string", "null"] },
    "category": { "type": "string", "enum": ["Flora", "Fauna", "Mineral", "Tool"] },
    "unit_price": { "type": "number", "minimum": 0 },
    "currency": { "type": "string", "default": "USD" },
    "unit": { "type": "string" },
    "package_size": { "type": "number" },
    "in_stock": { "type": "boolean" },
    "supplier_name": { "type": "string" },
    "provenance": { "type": "string" },
    "ethical_harvest_grade": { "type": "string" },
    "description": { "type": "string" }
  }
}

